{
  "name": "cascade-ui",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -p tsconfig.json && vite build",
    "build:demo": "tsc -p tsconfig.json && vite build --mode demo",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --experimental-strip-types --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
