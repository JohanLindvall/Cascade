{
  "name": "cascade-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for Cascade: REST + XML-RPC bridge to rtorrent over SCGI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "options:check": "npm run build --silent && node dist/optionsdoc.js",
    "options:docs": "npm run build --silent && node dist/optionsdoc.js --write",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --test \"dist-test/*.test.js\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}