{
  "name": "cascade-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for Cascade: REST + XML-RPC bridge to rtorrent over SCGI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "options:check": "npm run build --silent && node dist/optionsdoc.js",
    "options:docs": "npm run build --silent && node dist/optionsdoc.js --write"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  }
}
