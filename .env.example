# SPDX-License-Identifier: MIT

# Copy this file to .env and choose a password before docker compose up -d.
# Single quotes keep characters such as $ and # literal in a Compose .env file.
WEB_USER=admin
WEB_PASS=''

# Linux: use the output of id -u and id -g for the owner of your data directory.
PUID=1000
PGID=1000
TZ=Etc/UTC

# This parent directory holds config/, downloads/ and watch/.
CASCADE_DATA_DIR=./data
CASCADE_IMAGE=ghcr.io/johanlindvall/cascade:latest

# Host-side web binding. For remote access, use authentication and TLS.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Published on TCP and UDP; also sets rtorrent's listening port.
PEER_PORT=50000

# Additional container options belong under environment: in compose.yaml.
